#!/usr/bin/env bash
# Run one CI stage inside the CI image, the way GitHub Actions does.
#
# `make <stage>` runs the stage's script on whatever python is on PATH --
# the virtualenv, here. With IN_IMAGE set (which GITHUB_ACTIONS sets) the
# Makefile runs the same script through this wrapper instead: in
# ghcr.io/localnewsimpact/mizzou-ci-base, with the checkout mounted at
# /workspace. The stage's commands are one string either way; only the
# thing around them differs.
#
# Two things the image needs before any stage can start, once, rather
# than in every job of the workflow as they used to be:
#
#   - git refuses to read a repository owned by another uid unless told
#     it is safe. The mount is owned by the runner; the image runs as root.
#   - the image is built from the production base and mirrored, never
#     rebuilt by a pull request, so it holds what the LAST merge pinned.
#     Installing what THIS commit pins is a no-op when the image is current
#     and the difference when it is not (f12a478d: a dependency added in a
#     pull request could not pass CI at all).
set -euo pipefail
git config --global --add safe.directory /workspace

# Retried, because one of these requirements is fetched from github.com
# on every stage of every run.
#
#   requirements-base.txt:80
#   lnic-contracts @ https://github.com/.../archive/refs/tags/vX.Y.Z.tar.gz
#
# A 504 from GitHub therefore fails a stage that never ran, and reports
# it as that stage: PR #529 showed "checks / lint FAILURE" for a gateway
# timeout, with nothing linted. pip does not retry it either -- a 504 is
# an HTTP response rather than a connection error, so pip treats it as
# fatal and stops.
#
# Three attempts with a widening gap. A real failure -- a requirement
# that does not resolve, a conflict -- fails all three and still fails
# the run, only later. What this removes is the class of red build that
# has nothing to do with the commit.
for attempt in 1 2 3; do
    if pip install -q -r requirements-base.txt -r requirements-dev.txt; then
        break
    fi
    if [ "$attempt" = 3 ]; then
        echo "dependency install failed three times; giving up" >&2
        exit 1
    fi
    echo "dependency install failed (attempt $attempt of 3), retrying" >&2
    sleep $((attempt * 5))
done

exec "$@"
