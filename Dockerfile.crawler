# Multi-stage Dockerfile for Crawler services
# Handles discovery, extraction, and verification
# Optimized using shared base image

# Use ARG to allow override of base image location
ARG BASE_IMAGE=mizzou-base:latest

# Stage 1: Base with additional crawler system dependencies
FROM ${BASE_IMAGE} AS base-crawler

# Install system dependencies for browser automation (Selenium)
# Using Debian APT packages for both Chromium and ChromeDriver ensures version compatibility
# chromium-driver package is maintained to match chromium version in Debian repos
#
# WebGL Support: libegl1, libgl1-mesa-dri, libgles2 enable software rendering
# This is CRITICAL for bypassing bot detection - WebGL "Not Supported" is a major red flag
#
# Audio Support: libasound2, libpulse0 enable AudioContext API fingerprinting
# Many bot detectors check for audio processing capabilities
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        wget ca-certificates gnupg unzip curl \
        fonts-liberation libnss3 libxss1 xdg-utils libxdamage1 libx11-xcb1 xvfb xauth \
        libegl1 libgl1-mesa-dri libgles2 libgbm1 libasound2 libpulse0 \
        fonts-noto-color-emoji fonts-freefont-ttf && \
    # Add Google Chrome apt repo and install google-chrome-stable
    wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome-archive-keyring.gpg && \
    sh -c 'echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome-archive-keyring.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list' && \
    apt-get update && apt-get install -y --no-install-recommends google-chrome-stable && \
    # Install chromedriver using chromedriver-autoinstaller (fetches compatible version)
    pip install --no-cache-dir chromedriver-autoinstaller && \
    CHROMEDRIVER_PATH=$(python -c "import chromedriver_autoinstaller as c; print(c.install())") && \
    echo "Installing chromedriver from $CHROMEDRIVER_PATH" && \
    mkdir -p /home/appuser && cp "$CHROMEDRIVER_PATH" /home/appuser/chromedriver && chown appuser:appuser /home/appuser/chromedriver && chmod 755 /home/appuser/chromedriver && \
    ln -sf /home/appuser/chromedriver /usr/bin/chromedriver && \
    rm -rf /var/lib/apt/lists/* && \
    # Create cache directories for Selenium/undetected-chromedriver
    mkdir -p /opt/chromedriver-cache /home/appuser/.wdm && \
    chmod 777 /opt/chromedriver-cache /home/appuser/.wdm && \
    # Install mcookie for XAUTHORITY generation (part of util-linux)
    apt-get update && apt-get install -y --no-install-recommends uuid-runtime && \
    rm -rf /var/lib/apt/lists/* && \
    # Verify installation and version match
    echo "Google Chrome version: $(google-chrome --version)" && \
    echo "ChromeDriver version: $(chromedriver --version)"

WORKDIR /app

# Stage 2: Install Crawler-specific dependencies
FROM base-crawler AS deps

# Copy only crawler-specific requirements (selenium, newspaper4k, etc.)
COPY requirements-crawler.txt ./

# Install crawler-specific Python packages
RUN pip install --no-cache-dir -r requirements-crawler.txt

# Stage 3: Final runtime image
FROM base-crawler AS runtime

WORKDIR /app

# Copy crawler-specific packages from deps stage
# Base packages and spacy model are already in the base image
COPY --from=deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
COPY --from=deps /root/.cache /root/.cache

# appuser already created in base image, just set ownership
RUN chown -R appuser:appuser /app

# Copy application code
COPY --chown=appuser:appuser src/ ./src/
COPY --chown=appuser:appuser lookups/ ./lookups/
COPY --chown=appuser:appuser orchestration/ ./orchestration/
COPY --chown=appuser:appuser sitecustomize.py ./sitecustomize.py
COPY --chown=appuser:appuser fingerprints/ ./fingerprints/

# Copy xvfb wrapper script for proper X11 auth handling
COPY --chown=appuser:appuser scripts/xvfb-wrapper.sh /usr/local/bin/xvfb-wrapper.sh
RUN chmod +x /usr/local/bin/xvfb-wrapper.sh

# Create data directory for SQLite (will be replaced with Cloud SQL)
RUN mkdir -p /app/data && chown -R appuser:appuser /app/data

# Switch to non-root user
USER appuser

# Set environment variables
# ChromeDriver copied to /home/appuser for write access (undetected-chromedriver needs to patch it)
# SELENIUM_DRIVER_REUSE_LIMIT: Max reuses before recreating driver to prevent renderer process leak
# DISPLAY: Virtual display for headless Chrome via XVFB
# LIBGL_ALWAYS_SOFTWARE: Force Mesa software rendering for WebGL support
# GALLIUM_DRIVER: Use llvmpipe for software rendering
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CHROMEDRIVER_PATH=/home/appuser/chromedriver \
    CHROME_BIN=/usr/bin/google-chrome \
    DISPLAY=:99 \
    SELENIUM_DRIVER_REUSE_LIMIT=10 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    MESA_GL_VERSION_OVERRIDE=4.5

# No default dataset: collection is always dataset-scoped (decided
# 2026-08-21), and discover-urls refuses to run without --dataset. The
# CronJob manifest (k8s/crawler-cronjob.yaml) supplies the dataset
# explicitly; a bare `docker run` of this image exits with a usage error
# instead of silently crawling a baked-in dataset.
CMD ["python", "-m", "src.cli.main", "discover-urls"]
