# Legit CLI command source that the broad test_*.py pattern wrongly caught —
# referenced by src/cli/cli_modular.py ("test-domain" command). Without this
# it never got committed, so the command was dead in prod and its test failed
# to import in CI.
!src/cli/commands/test_domain.py
!tests/
!tests/**

# ...but never track Python bytecode/caches under tests/ — the broad "!tests/**"
# above otherwise re-includes them, which kept committing *.pyc for months.
tests/**/__pycache__/
tests/**/*.pyc
tests/**/*.pyo

# Temporary test output
new_detector_*.csv
new_detector_*.txt

